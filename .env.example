# --- Supabase (cloud, atau lokal via `npx supabase start`: URL http://127.0.0.1:54321) ---
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=...              # anon public key
SUPABASE_SERVICE_ROLE_KEY=...      # RAHASIA, jangan dipakai di browser
QR_SECRET=ganti-dengan-string-acak-panjang

# --- Akun default untuk testing (dibuat oleh `npm run seed`) ---
DEFAULT_ADMIN_EMAIL=admin@hadirin.test
DEFAULT_ADMIN_PASSWORD=admin12345
DEFAULT_EMPLOYEE_PASSWORD=karyawan123
SEED_SAMPLE_EMPLOYEES=true         # contoh: karyawan1..3@hadirin.test
